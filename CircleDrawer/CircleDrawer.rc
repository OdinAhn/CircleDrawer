// CircleDrawer 리소스 스크립트
#include "resource.h"
#include "afxres.h"

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

IDD_CIRCLEDRAWER_DIALOG DIALOGEX 0, 0, 440, 370
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "세 점을 지나는 원 그리기"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "클릭 원 반지름",IDC_STATIC,7,9,52,8
    EDITTEXT        IDC_EDIT_RADIUS,60,7,30,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "정원 두께",IDC_STATIC,100,9,34,8
    EDITTEXT        IDC_EDIT_THICKNESS,136,7,30,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "초기화",IDC_BTN_RESET,306,6,60,14
    PUSHBUTTON      "랜덤 이동",IDC_BTN_RANDOM,373,6,60,14
    LTEXT           "P1 : -",IDC_STATIC_P1,7,26,110,8
    LTEXT           "P2 : -",IDC_STATIC_P2,120,26,110,8
    LTEXT           "P3 : -",IDC_STATIC_P3,233,26,110,8
    LTEXT           "",IDC_STATIC_STATUS,7,39,426,8
    CONTROL         "",IDC_STATIC_VIEW,"Static",SS_BLACKFRAME,7,52,426,311
END
